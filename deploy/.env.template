# ============================================================
#  环境变量模板 — 中超预测后端
#
#  使用方法：
#    1. 复制此文件为 .env：  cp .env.template .env
#    2. 填写真实的值
#    3. .env 文件不要提交到 git（已在 .gitignore 中排除）
#
#  此文件被 systemd 的 EnvironmentFile 引用，
#  也被 start_prod.sh 脚本 source。
# ============================================================

# ---- 必填 ----

# API-Football 密钥（启用实时数据源）
# 注册地址：https://www.api-football.com/
# 免费档约 100 请求/天，已内置缓存与重试
API_FOOTBALL_KEY=

# ---- 可选 ----

# 监听端口（默认 5001，Gunicorn 绑定 127.0.0.1:5001 由 Nginx 代理）
PORT=5001

# 实时数据源选择：
#   不设（默认）= 使用 API-Football 真实源（需 API_FOOTBALL_KEY）
#   sim        = 使用模拟数据源（无需 key，用于演示/测试）
LIVE_SOURCE=

# Gunicorn 配置（覆盖 gunicorn_conf.py 里的默认值）
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60

# Flask 调试模式（生产环境务必为 0）
FLASK_DEBUG=0
